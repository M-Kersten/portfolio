# Deploy base path. Leave unset (defaults to "/") for Vercel or a custom domain.
# For a GitHub Pages project site served at https://<user>.github.io/portfolio/:
#   VITE_BASE=/portfolio/
VITE_BASE=/

# Launch-counter backend (optional — docs/launch-counter.md has the 5-minute
# setup). Copy to .env.local for dev. Without these the site builds and runs
# fine; the launch tally just stays hidden. The anon key is public by design.
VITE_SUPABASE_URL=https://YOURPROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
