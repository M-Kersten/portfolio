# Deploy base path. Leave unset (defaults to "/") for Vercel or a custom domain.
# For a GitHub Pages project site served at https://<user>.github.io/portfolio/:
#   VITE_BASE=/portfolio/
VITE_BASE=/

# The counters' backend (optional — docs/counters.md has the 5-minute setup):
# the flights, the ticket numbers, the visitors who saw all ten. Copy to
# .env.local for dev. Without these the site builds and runs fine; the numbers
# just stay hidden. The anon key is public by design.
VITE_SUPABASE_URL=https://YOURPROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
