{
  "name": "merijn-kersten-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Editorial, typography-led portfolio for enterprise VR/AR/digital-twin work. One React Three Fiber renderer, two scenes.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-content.mjs && node scripts/gen-sitemap.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "node scripts/check-content.mjs",
    "typecheck": "tsc --noEmit",
    "sitemap": "node scripts/gen-sitemap.mjs",
    "posters": "node scripts/optimize-posters.mjs",
    "cv": "npm run build && node scripts/generate-cv.mjs"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.2.10",
    "@fontsource/space-mono": "^5.2.9",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.19.1",
    "postprocessing": "^6.39.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "playwright-core": "^1.56.1",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
