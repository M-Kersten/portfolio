@*
    Editor for a case's outbound links. Built on the same bones as GalleryList
    and for the same reason: two fields per row, so it can't reuse StringList,
    and the ordering controls matter because the order here IS the order the
    buttons appear in the case dialogs. Moving a row is editing the content.

    Label first, URL second — the label is the part that gets thought about and
    the part that used to be impossible to set, so it leads. The URL is usually
    pasted.
*@
@using Portfolio.Cms.Core.Models

<div class="string-list">
    @for (var i = 0; i < Items.Count; i++)
    {
        var index = i;
        var link = Items[index];
        <div class="string-list__row">
            <div class="field-row" style="flex: 1;">
                <label class="field">
                    <span>Button text</span>
                    <input class="input" value="@link.Label" placeholder="Read the write-up"
                           @onchange="e => SetLabel(index, e.Value?.ToString())" />
                </label>
                <label class="field" style="flex: 2;">
                    <span>URL</span>
                    <input class="input" value="@link.Url" placeholder="https://…"
                           @onchange="e => SetUrl(index, e.Value?.ToString())" />
                </label>
            </div>
            <div class="string-list__controls">
                <button type="button" class="btn btn--icon" title="Move up"
                        disabled="@(index == 0)" @onclick="() => Move(index, -1)">↑</button>
                <button type="button" class="btn btn--icon" title="Move down"
                        disabled="@(index == Items.Count - 1)" @onclick="() => Move(index, 1)">↓</button>
                <button type="button" class="btn btn--icon btn--danger" title="Remove"
                        @onclick="() => Remove(index)">✕</button>
            </div>
        </div>
    }

    @if (Items.Count == 0)
    {
        <p class="muted">No links. Add one for each write-up, talk, press piece or film worth pointing at.</p>
    }

    <button type="button" class="btn btn--ghost" @onclick="Add">+ Add link</button>
</div>

@code {
    [Parameter, EditorRequired] public List<CaseLink> Items { get; set; } = [];

    /// <summary>Raised after any change so the parent can mark itself dirty.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private async Task SetLabel(int index, string? value)
    {
        Items[index].Label = (value ?? "").Trim();
        await Changed.InvokeAsync();
    }

    private async Task SetUrl(int index, string? value)
    {
        // Add the protocol to a bare host rather than rejecting it. Pasting
        // "merijnkersten.nl/thing" is the obvious slip, and without a scheme the
        // browser resolves it against the CMS's own origin — so the button 404s
        // on the wrong domain instead of going where it was meant to. Anything
        // still malformed is caught by the validator before publish.
        var url = (value ?? "").Trim();
        if (url.Length > 0
            && !url.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            && !url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            url = "https://" + url;
        Items[index].Url = url;
        await Changed.InvokeAsync();
    }

    private async Task Add()
    {
        Items.Add(new CaseLink { Url = "", Label = "" });
        await Changed.InvokeAsync();
    }

    private async Task Remove(int index)
    {
        Items.RemoveAt(index);
        await Changed.InvokeAsync();
    }

    private async Task Move(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= Items.Count) return;
        (Items[index], Items[target]) = (Items[target], Items[index]);
        await Changed.InvokeAsync();
    }
}
